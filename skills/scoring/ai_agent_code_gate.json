{
  "skill": "scoring/ai_agent_code_gate",
  "applies_to": "arcade-attest Decision API scoring@1",
  "id": "ai_agent_code_gate",
  "name": "AI Agent Code Gate",
  "appetite": "agent_risk_averse",
  "description": "Code produced by AI agents: smells, god components, coupling, containment and evidence confidence dominate.",
  "apply_when": {
    "signals": [
      "ai-agent",
      "agent-code",
      "ai-generated"
    ]
  },
  "weights": {
    "smell_regression": 3.0,
    "responsibility_stability": 2.0,
    "god_component_risk": 3.0,
    "component_balance": 1.5,
    "modularity_trend": 1.5,
    "cohesion_trend": 1.0,
    "coupling_control": 3.0,
    "recovery_confidence_trend": 1.0,
    "change_containment": 2.5,
    "evidence_confidence": 2.5
  },
  "how_to_apply": {
    "decision_record_field": "scoring.profile",
    "value": "ai_agent_code_gate",
    "custom_override_field": "scoring.weights",
    "rule": "Weights change the advisory overall score only. Predicate verdicts and thresholds never move."
  }
}
