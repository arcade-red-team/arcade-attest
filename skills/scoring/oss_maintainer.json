{
  "skill": "scoring/oss_maintainer",
  "applies_to": "arcade-attest Decision API scoring@1",
  "id": "oss_maintainer",
  "name": "OSS Maintainer Triage",
  "appetite": "maintainer_triage",
  "description": "High-volume PR triage: evidence confidence, smells, stability and containment decide what needs a human first.",
  "apply_when": {
    "signals": [
      "oss",
      "maintainer",
      "review-triage",
      "high-volume pr"
    ]
  },
  "weights": {
    "smell_regression": 2.5,
    "responsibility_stability": 2.0,
    "god_component_risk": 1.5,
    "component_balance": 1.0,
    "modularity_trend": 1.0,
    "cohesion_trend": 0.75,
    "coupling_control": 1.0,
    "recovery_confidence_trend": 0.75,
    "change_containment": 2.5,
    "evidence_confidence": 3.0
  },
  "how_to_apply": {
    "decision_record_field": "scoring.profile",
    "value": "oss_maintainer",
    "custom_override_field": "scoring.weights",
    "rule": "Weights change the advisory overall score only. Predicate verdicts and thresholds never move."
  }
}
